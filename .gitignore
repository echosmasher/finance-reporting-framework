# Archon runtime artifacts — NEVER commit
.archon/state/
.archon/.env

# OS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Editors
.vscode/
.idea/

# Env files — never commit secrets
.env
.env.local

# Working directories — user data, not source (see PLAN.md §3).
# Anchored to repo root: must NOT match examples/example-hotels/{inbox,outputs},
# whose contents are the committed demo and are tracked deliberately.
/inbox/*
!/inbox/.gitkeep
/outputs/*
!/outputs/.gitkeep
/config/*
!/config/.gitkeep
/references/*
!/references/.gitkeep
/feedback/*
!/feedback/.gitkeep
